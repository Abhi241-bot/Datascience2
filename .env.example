# ── Copy to .env and fill in. .env is git-ignored. ──────────────────────────

# Orchestrator LLM (Groq — free tier: https://console.groq.com/keys)
GROQ_API_KEY=
# llama-3.1-8b-instant = fast + roomy free daily limit; swap to
# llama-3.3-70b-versatile for stronger reasoning (smaller daily token budget).
ORCHESTRATOR_MODEL=llama-3.1-8b-instant

# Text-to-SQL fine-tuned adapter (set to your HF Hub repo after Phase 1, e.g.
# "your-username/llama31-spider-sql-qlora"; leave blank to load from finetune/adapter/)
SQL_ADAPTER_REPO=
SQL_BASE_MODEL=unsloth/Meta-Llama-3.1-8B-Instruct-bnb-4bit

# Web search (optional — falls back to free DuckDuckGo if unset)
TAVILY_API_KEY=

# Observability (optional — LangSmith free tier: https://smith.langchain.com)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent-analyst

# HF Hub (optional — for pushing/pulling the adapter)
HF_TOKEN=
