# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# Env / secrets
.env
.env.*
!.env.example

# Data / models (large; not committed)
# Real SEC 10-K corpus (.md) IS committed; everything else in corpus/ is not.
data/corpus/*
!data/corpus/.gitkeep
!data/corpus/*.md
data/chroma/
*.sqlite
*.db
!data/db/financials.sql
finetune/adapter/*
!finetune/adapter/.gitkeep
*.gguf
*.safetensors
*.bin

# Spider dataset (downloaded, large)
finetune/data/
spider/

# Eval artifacts — keep the committed scorecards (read by the Gradio Evals tab),
# ignore everything else.
eval_results/*
!eval_results/.gitkeep
!eval_results/ragas_scorecard.json
!eval_results/deepeval_scorecard.json

# LangSmith / caches
.langsmith/
.cache/

# Notebooks
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
